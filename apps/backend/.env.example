# Node Environment
NODE_ENV=development

# Server
PORT=3000

# Database (PostgreSQL via @restaurant/database)
# Match docker-compose.yml credentials and the host port (5433).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/restaurant_pos?schema=public"

# JWT secrets — generate strong values, e.g. `openssl rand -base64 48`.
# NEVER commit real secrets. These are dev placeholders only.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# Public-facing base URL (used to build QR codes)
PUBLIC_BASE_URL=http://localhost:3000

# CORS allowed origin(s). Comma-separate for multiple, or `*` to allow any.
CORS_ORIGIN=http://localhost:5173

# Authentication rate limiting (milliseconds window, max attempts)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_LOGIN_MAX=10
AUTH_RATE_LIMIT_REFRESH_MAX=30

# API documentation (Swagger UI). Defaults to true in development, false in production.
SWAGGER_ENABLED=true
