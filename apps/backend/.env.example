# Node Environment
NODE_ENV=development

# Server
PORT=3000

# Database (PostgreSQL via @restaurant/database)
# Match docker-compose.yml credentials and the host port (5433).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/restaurant_pos?schema=public"

# JWT secrets — generate strong values, e.g. `openssl rand -base64 48`.
# NEVER commit real secrets. These are dev placeholders only.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# Public-facing base URL (used to build QR codes)
PUBLIC_BASE_URL=http://localhost:3000

# CORS allowed origin(s). Comma-separate for multiple, or `*` to allow any.
CORS_ORIGIN=http://localhost:5173

# Authentication rate limiting (milliseconds window, max attempts)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_LOGIN_MAX=10
AUTH_RATE_LIMIT_REFRESH_MAX=30

# API documentation (Swagger UI). Defaults to true in development, false in production.
SWAGGER_ENABLED=true

# Loyalty points (Phase 5.2)
# Currency units (e.g. EGP) spent per 1 loyalty point.
LOYALTY_AMOUNT_PER_POINT=10
# Months after earning before points expire.
LOYALTY_POINT_EXPIRY_MONTHS=12
# Lifetime-points thresholds for Silver / Gold tiers (Bronze is the default).
LOYALTY_SILVER_THRESHOLD=500
LOYALTY_GOLD_THRESHOLD=2000

# Stripe online payments (Phase 6.1) — leave empty to disable pay-online.
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ISO currency for PaymentIntents (EGP = piastres as the minor unit).
STRIPE_CURRENCY=egp

# Paymob online payments (Phase 6.2) — leave empty to disable Paymob.
# Get values from https://accept.paymob.com/portal (Settings -> Account Info,
# Developers -> Payment Integrations).
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_CURRENCY=EGP
